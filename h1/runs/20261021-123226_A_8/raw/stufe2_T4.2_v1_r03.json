          "annotations": [],
          "text": "{\"funde\":[{\"regelwerk\":\"AGG\",\"fundstelle\":\"§ 7 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Bei den Vorstellungsgesprächen dürfen Bewerbende nicht wegen eines in § 1 AGG genannten Grundes benachteiligt werden. Das gilt für Fragen, Gesprächsführung und Bewertung.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/agg/__7.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 15 G v. 22.12.2023 I Nr. 414\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"GG\",\"fundstelle\":\"Art. 3 Abs. 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Als staatliche Hochschule muss die Auswahlkommission die Gleichberechtigung von Frauen und Männern beachten und auf die Beseitigung bestehender Nachteile hinwirken.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/gg/art_3.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 1 G v. 22.3.2025 I Nr. 94\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"GG\",\"fundstelle\":\"Art. 3 Abs. 3\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Die Gesprächsführung und Bewertung dürfen Bewerbende insbesondere nicht wegen ihres Geschlechts, ihrer Herkunft, ihres Glaubens oder einer Behinderung benachteiligen.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/gg/art_3.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 1 G v. 22.3.2025 I Nr. 94\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"GG\",\"fundstelle\":\"Art. 33 Abs. 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Die Auswahl im öffentlichen Dienst muss sich am Grundsatz der Bestenauslese nach Eignung, Befähigung und fachlicher Leistung orientieren; dies prägt auch die Bewertung in den Vorstellungsgesprächen.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/gg/art_33.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 1 G v. 22.3.2025 I Nr. 94\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"BayPVG\",\"fundstelle\":\"Art. 75 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Mitbestimmung betrifft die Einstellung; die Vorschrift begründet nicht ausdrücklich eine Teilnahme des Personalrats an jedem Vorstellungsgespräch.\",\"begruendung\":\"Der Personalrat hat bei Einstellungen mitzubestimmen. Die Vorstellungsgespräche gehören zum Auswahlverfahren, das der Einstellungsentscheidung vorausgeht; das konkrete Beteiligungsverfahren ist im Prozess zu berücksichtigen.\",\"quelle_url\":\"https://www.gesetze-bayern.de/Content/Document/BayPVG-75\",\"fassung_datum\":\"Text gilt ab 01.08.2023\",\"sicherheit\":\"unsicher\"}]}",
          "type": "output_text",
