                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": null,
                "begruendung": "Die Auswertung der Bewerbungsunterlagen muss insbesondere rechtmäßig und transparent, zweckgebunden, auf das erforderliche Maß beschränkt, sachlich richtig sowie sicher erfolgen. Das gilt auch für die Eingaben und Ergebnisse des KI-Tools.",
                "quelle_url": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_5",
                "fassung_datum": "konsolidierte Fassung vom 04.05.2016",
                "sicherheit": "sicher"
