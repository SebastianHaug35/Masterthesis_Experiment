          "annotations": [],
          "text": "{\"funde\":[{\"regelwerk\":\"BayGlG\",\"fundstelle\":\"Art. 17 Abs. 3 Satz 4\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Spätestens mit der Einladung zum Vorstellungsgespräch muss auf das Antragsrecht der Betroffenen hingewiesen werden, die Gleichstellungsbeauftragte am Gespräch zu beteiligen. Der Task sieht diesen Hinweis ausdrücklich vor.\",\"quelle_url\":\"https://www.gesetze-bayern.de/Content/Document/BayGlG-17\",\"fassung_datum\":\"Text gilt ab 01.04.2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"AGG\",\"fundstelle\":\"§ 7 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Die Auswahl, welche Bewerberinnen und Bewerber zum Vorstellungsgespräch eingeladen werden, darf nicht zu einer Benachteiligung wegen eines in § 1 AGG genannten Grundes führen.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/agg/__7.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 15 G v. 22.12.2023 I Nr. 414\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 6 Abs. 1 Buchst. e i.V.m. Abs. 3\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Verarbeitung der Bewerberdaten zum Versand der Einladung benötigt eine einschlägige Rechtsgrundlage nach Unions- oder nationalem Recht.\",\"begruendung\":\"Die Verwendung personenbezogener Bewerberdaten für die Einladung muss rechtmäßig sein. Für eine öffentliche Hochschule kommt insbesondere die Erforderlichkeit zur Wahrnehmung einer Aufgabe im öffentlichen Interesse in Betracht; die dafür maßgebliche Rechtsgrundlage muss nach Art. 6 Abs. 3 festgelegt sein.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_6\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"unsicher\"}]}",
          "type": "output_text",
          "logprobs": [],
          "parsed": {
            "funde": [
              {
                "regelwerk": "BayGlG",
                "fundstelle": "Art. 17 Abs. 3 Satz 4",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": null,
                "begruendung": "Spätestens mit der Einladung zum Vorstellungsgespräch muss auf das Antragsrecht der Betroffenen hingewiesen werden, die Gleichstellungsbeauftragte am Gespräch zu beteiligen. Der Task sieht diesen Hinweis ausdrücklich vor.",
                "quelle_url": "https://www.gesetze-bayern.de/Content/Document/BayGlG-17",
                "fassung_datum": "Text gilt ab 01.04.2026",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "AGG",
                "fundstelle": "§ 7 Abs. 1",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": null,
                "begruendung": "Die Auswahl, welche Bewerberinnen und Bewerber zum Vorstellungsgespräch eingeladen werden, darf nicht zu einer Benachteiligung wegen eines in § 1 AGG genannten Grundes führen.",
                "quelle_url": "https://www.gesetze-im-internet.de/agg/__7.html",
                "fassung_datum": "Stand Zuletzt geändert durch Art. 15 G v. 22.12.2023 I Nr. 414",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "DSGVO",
                "fundstelle": "Art. 6 Abs. 1 Buchst. e i.V.m. Abs. 3",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Die Verarbeitung der Bewerberdaten zum Versand der Einladung benötigt eine einschlägige Rechtsgrundlage nach Unions- oder nationalem Recht.",
                "begruendung": "Die Verwendung personenbezogener Bewerberdaten für die Einladung muss rechtmäßig sein. Für eine öffentliche Hochschule kommt insbesondere die Erforderlichkeit zur Wahrnehmung einer Aufgabe im öffentlichen Interesse in Betracht; die dafür maßgebliche Rechtsgrundlage muss nach Art. 6 Abs. 3 festgelegt sein.",
                "quelle_url": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_6",
                "fassung_datum": "konsolidierte Fassung vom 04.05.2016",
                "sicherheit": "unsicher"
              }
            ]
          }
        }
