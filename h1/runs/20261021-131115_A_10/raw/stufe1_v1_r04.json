          "annotations": [],
          "text": "{\"rechtsrahmen\":[{\"regelwerk\":\"Verordnung (EU) 2016/679\",\"vollstaendiger_titel\":\"Verordnung (EU) 2016/679 des Europäischen Parlaments und des Rates vom 27. April 2016 zum Schutz natürlicher Personen bei der Verarbeitung personenbezogener Daten, zum freien Datenverkehr und zur Aufhebung der Richtlinie 95/46/EG (Datenschutz-Grundverordnung)\",\"ebene\":\"EU\",\"begruendung\":\"Gilt für die Verarbeitung personenbezogener Daten von Bewerberinnen und Bewerbern im Bewerbungsportal, bei der KI-Auswertung und beim Ranking, bei der Dokumentation der Auswahl sowie bei Aufbewahrung und Löschung.\",\"betroffene_teilprozesse\":[\"2\",\"3\",\"4\",\"5\",\"6\"],\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32016R0679\",\"fassung_datum\":\"\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"BayDSG\",\"vollstaendiger_titel\":\"Bayerisches Datenschutzgesetz\",\"ebene\":\"Land\",\"begruendung\":\"Ergänzt den Datenschutzrahmen für die Hochschule München als bayerische öffentliche Stelle, insbesondere bei der Verarbeitung von Bewerberdaten und beim Einsatz eines KI-Systems.\",\"betroffene_teilprozesse\":[\"2\",\"3\",\"4\",\"5\",\"6\"],\"quelle_url\":\"https://www.gesetze-bayern.de/Content/Document/BayDSG\",\"fassung_datum\":\"\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"Verordnung (EU) 2024/1689\",\"vollstaendiger_titel\":\"Verordnung (EU) 2024/1689 des Europäischen Parlaments und des Rates vom 13. Juni 2024 zur Festlegung harmonisierter Vorschriften für künstliche Intelligenz und zur Änderung der Verordnungen (EG) Nr. 300/2008, (EU) Nr. 167/2013, (EU) Nr. 168/2013, (EU) 2018/858, (EU) 2018/1139 und (EU) 2019/2144 sowie der Richtlinien 2014/90/EU, (EU) 2016/797 und (EU) 2020/1828 (Verordnung über künstliche Intelligenz)\",\"ebene\":\"EU\",\"begruendung\":\"Der Einsatz eines KI-Tools zur Vorauswahl und zum Ranking von Bewerbungen fällt in den Bereich KI-Systeme für Beschäftigung und Personalauswahl; die Verordnung ist deshalb für den KI-gestützten Teil des Verfahrens relevant. Die zeitliche Anwendbarkeit einzelner Pflichten kann gestaffelt sein.\",\"betroffene_teilprozesse\":[\"3\"],\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32024R1689\",\"fassung_datum\":\"\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"agg\",\"vollstaendiger_titel\":\"Allgemeines Gleichbehandlungsgesetz\",\"ebene\":\"Bund\",\"begruendung\":\"Gilt für Stellenausschreibung, Auswahl, Vorstellungsgespräche und Einstellungsentscheidung und untersagt Benachteiligungen bei Zugang zur Beschäftigung.\",\"betroffene_teilprozesse\":[\"1\",\"3\",\"4\",\"5\",\"6\"],\"quelle_url\":\"https://www.gesetze-im-internet.de/agg/\",\"fassung_datum\":\"\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"BayGlG\",\"vollstaendiger_titel\":\"Bayerisches Gleichstellungsgesetz\",\"ebene\":\"Land\",\"begruendung\":\"Für die bayerische öffentliche Hochschule und ihre Gleichstellungsbeauftragte bei gleichstellungsrelevanten Personalverfahren einschließlich Ausschreibung, Auswahl und Beteiligung im Vorstellungsgespräch relevant.\",\"betroffene_teilprozesse\":[\"1\",\"3\",\"4\",\"5\"],\"quelle_url\":\"https://www.gesetze-bayern.de/Content/Document/BayGlG\",\"fassung_datum\":\"\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"BayPVG\",\"vollstaendiger_titel\":\"Bayerisches Personalvertretungsgesetz\",\"ebene\":\"Land\",\"begruendung\":\"Gilt wegen der Personalvertretung bei personalbezogenen Maßnahmen der Hochschule; zudem kann die Einführung oder Anwendung technischer Systeme zur Bewerberdatenverarbeitung und KI-Vorauswahl personalvertretungsrechtliche Beteiligung auslösen.\",\"betroffene_teilprozesse\":[\"1\",\"2\",\"3\",\"4\",\"5\"],\"quelle_url\":\"https://www.gesetze-bayern.de/Content/Document/BayPVG\",\"fassung_datum\":\"\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"BayHIG\",\"vollstaendiger_titel\":\"Bayerisches Hochschulinnovationsgesetz\",\"ebene\":\"Land\",\"begruendung\":\"Regelt den hochschulrechtlichen Rahmen für wissenschaftliche Mitarbeiterinnen und Mitarbeiter und deren Weiterqualifizierung an einer bayerischen Hochschule; damit für die Qualifizierungsstelle und die Einstellung relevant.\",\"betroffene_teilprozesse\":[\"1\",\"5\"],\"quelle_url\":\"https://www.gesetze-bayern.de/Content/Document/BayHIG\",\"fassung_datum\":\"\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"wisszeitvg\",\"vollstaendiger_titel\":\"Gesetz über befristete Arbeitsverträge in der Wissenschaft\",\"ebene\":\"Bund\",\"begruendung\":\"Die Stelle ist als wissenschaftliche Qualifizierungsstelle zur Promotion für drei Jahre befristet; das Gesetz ist daher zentral für die Befristung und den Vertragsabschluss.\",\"betroffene_teilprozesse\":[\"1\",\"5\"],\"quelle_url\":\"https://www.gesetze-im-internet.de/wisszeitvg/\",\"fassung_datum\":\"\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"tzbfg\",\"vollstaendiger_titel\":\"Gesetz über Teilzeitarbeit und befristete Arbeitsverträge\",\"ebene\":\"Bund\",\"begruendung\":\"Enthält den allgemeinen gesetzlichen Rahmen für befristete Arbeitsverträge und ist ergänzend zur wissenschaftsspezifischen Befristungsregelung für den Vertrag relevant.\",\"betroffene_teilprozesse\":[\"1\",\"5\"],\"quelle_url\":\"https://www.gesetze-im-internet.de/tzbfg/\",\"fassung_datum\":\"\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"TV-L\",\"vollstaendiger_titel\":\"Tarifvertrag für den öffentlichen Dienst der Länder (TV-L)\",\"ebene\":\"Tarif\",\"begruendung\":\"Die Stelle ist ausdrücklich nach TV-L zu besetzen; der Tarifvertrag ist für Stellenprofil, Eingruppierung und die arbeitsvertraglichen Bedingungen maßgeblich.\",\"betroffene_teilprozesse\":[\"1\",\"5\"],\"quelle_url\":\"https://www.tdl-online.de/tarifvertraege/tv-l\",\"fassung_datum\":\"\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"bgb\",\"vollstaendiger_titel\":\"Bürgerliches Gesetzbuch\",\"ebene\":\"Bund\",\"begruendung\":\"Enthält den allgemeinen zivilrechtlichen Rahmen für den Abschluss und Inhalt des Arbeitsvertrags, soweit keine spezielleren arbeitsrechtlichen Vorschriften oder Tarifregelungen vorgehen.\",\"betroffene_teilprozesse\":[\"5\"],\"quelle_url\":\"https://www.gesetze-im-internet.de/bgb/\",\"fassung_datum\":\"\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"sgb9ua_ndg\",\"vollstaendiger_titel\":\"Sozialgesetzbuch - Neuntes Buch - (SGB IX) Rehabilitation und Teilhabe behinderter Menschen\",\"ebene\":\"Bund\",\"begruendung\":\"Kann insbesondere bei Bewerbungen schwerbehinderter Menschen Pflichten des öffentlichen Arbeitgebers im Auswahlverfahren und bei der Einladung zu Vorstellungsgesprächen auslösen.\",\"betroffene_teilprozesse\":[\"1\",\"3\",\"4\",\"5\"],\"quelle_url\":\"https://www.gesetze-im-internet.de/sgb9ua_ndg/\",\"fassung_datum\":\"\",\"sicherheit\":\"sicher\"}]}",
