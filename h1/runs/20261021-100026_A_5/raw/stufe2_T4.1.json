          "annotations": [],
          "text": "{\"funde\":[{\"regelwerk\":\"BayGlG\",\"fundstelle\":\"Art. 17 Abs. 3 Satz 3 und 4\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"In der Einladung spätestens auf das Antragsrecht zur Beteiligung der Gleichstellungsbeauftragten am Vorstellungsgespräch hinweisen. Die Beteiligung findet nur auf Antrag der betroffenen Person statt.\",\"begruendung\":\"Die Vorschrift regelt unmittelbar die Beteiligung der Gleichstellungsbeauftragten an Vorstellungsgesprächen und verlangt ausdrücklich, spätestens in der Einladung auf das Antragsrecht hinzuweisen.\",\"quelle_url\":\"https://www.gesetze-bayern.de/Content/Document/BayGlG-17\",\"fassung_datum\":\"Text gilt ab 01.04.2026; abgerufen am 21.10.2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"SGB IX\",\"fundstelle\":\"§ 165 Satz 3 und 4\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Schwerbehinderte oder gleichgestellte Bewerberinnen und Bewerber sind grundsätzlich zum Vorstellungsgespräch einzuladen. Eine Einladung ist nur entbehrlich, wenn die fachliche Eignung offensichtlich fehlt.\",\"begruendung\":\"Als öffentliche Arbeitgeberin muss die Hochschule die besondere Einladungspflicht bei Bewerbungen schwerbehinderter Menschen und gleichgestellter behinderter Menschen beachten.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/sgb_9_2018/__165.html\",\"fassung_datum\":\"Normstand abgerufen am 21.10.2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"GG\",\"fundstelle\":\"Art. 33 Abs. 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Einladungsauswahl muss sich am gleichen Zugang zu öffentlichen Ämtern nach Eignung, Befähigung und fachlicher Leistung orientieren.\",\"begruendung\":\"Der verfassungsrechtliche Leistungsgrundsatz prägt den Zugang zu Stellen im öffentlichen Dienst und ist bei der Auswahl der Personen für Vorstellungsgespräche zu beachten.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/gg/art_33.html\",\"fassung_datum\":\"Zuletzt geändert durch Gesetz vom 22.03.2025; Normstand abgerufen am 21.10.2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"AGG\",\"fundstelle\":\"§ 7 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Bei der Entscheidung, welche Bewerberinnen und Bewerber eingeladen werden, darf keine Benachteiligung aus einem in § 1 AGG genannten Grund erfolgen.\",\"begruendung\":\"Das Benachteiligungsverbot gilt für Bewerberinnen und Bewerber und damit auch für die Einladungsauswahl im Bewerbungsverfahren.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/agg/__7.html\",\"fassung_datum\":\"Zuletzt geändert durch Gesetz vom 22.12.2023; Normstand abgerufen am 21.10.2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"AGG\",\"fundstelle\":\"§ 6 Abs. 1 Satz 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Die Vorschrift stellt klar, dass Bewerberinnen und Bewerber für ein Beschäftigungsverhältnis als Beschäftigte im Sinne des AGG gelten; damit ist das Benachteiligungsverbot des § 7 auf sie anwendbar.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/agg/__6.html\",\"fassung_datum\":\"Normstand abgerufen am 21.10.2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 5 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Für den Versand der Einladungen nur erforderliche Bewerberdaten verwenden und diese rechtmäßig sowie zweckgebunden verarbeiten.\",\"begruendung\":\"Das Erstellen und Versenden von Einladungen verarbeitet personenbezogene Bewerberdaten und muss daher die Grundsätze der DSGVO einhalten.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX%3A32016R0679\",\"fassung_datum\":\"Verordnung vom 27.04.2016; EUR-Lex-Fassung abgerufen am 21.10.2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 6 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Für die Verarbeitung der Kontaktdaten zum Versand der Einladung muss eine einschlägige Rechtsgrundlage vorliegen und festgelegt sein.\",\"begruendung\":\"Der Versand einer Einladung setzt die Verarbeitung personenbezogener Kontaktdaten voraus; diese Verarbeitung ist nur bei Vorliegen mindestens einer Rechtsgrundlage nach Art. 6 Abs. 1 DSGVO rechtmäßig.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX%3A32016R0679\",\"fassung_datum\":\"Verordnung vom 27.04.2016; EUR-Lex-Fassung abgerufen am 21.10.2026\",\"sicherheit\":\"sicher\"}]}",
