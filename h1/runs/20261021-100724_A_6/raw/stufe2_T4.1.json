          "annotations": [],
          "text": "{\"funde\":[{\"regelwerk\":\"BayGlG\",\"fundstelle\":\"Art. 17 Abs. 3 Satz 4\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Einladung muss spätestens auf das Antragsrecht zur Beteiligung der Gleichstellungsbeauftragten am Vorstellungsgespräch hinweisen.\",\"begruendung\":\"Die Vorschrift verlangt ausdrücklich, dass auf das Antragsrecht spätestens im Rahmen der Einladung zum Vorstellungsgespräch hingewiesen wird.\",\"quelle_url\":\"https://www.gesetze-bayern.de/Content/Document/BayGlG-17\",\"fassung_datum\":\"Text gilt ab 01.04.2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"SGB IX\",\"fundstelle\":\"§ 165\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Schwerbehinderte Bewerberinnen und Bewerber sind zum Vorstellungsgespräch einzuladen, sofern ihre fachliche Eignung nicht offensichtlich fehlt.\",\"begruendung\":\"Als öffentlicher Arbeitgeber muss die Hochschule die besondere Einladungspflicht bei Bewerbungen schwerbehinderter Menschen beachten.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/sgb_9_2018/__165.html\",\"fassung_datum\":\"Konsolidierte Onlinefassung, abgerufen am 21.10.2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"SGB IX\",\"fundstelle\":\"§ 178 Abs. 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Bei Bewerbungen schwerbehinderter Menschen ist die Schwerbehindertenvertretung grundsätzlich zu beteiligen; sie hat insbesondere das Recht, an Vorstellungsgesprächen teilzunehmen. Eine Beteiligung unterbleibt, wenn die betroffene Person sie ausdrücklich ablehnt.\",\"begruendung\":\"Die Einladung und Vorbereitung des Gesprächs muss die gesetzlichen Beteiligungs- und Teilnahmerechte der Schwerbehindertenvertretung berücksichtigen, sofern eine Bewerbung eines schwerbehinderten Menschen vorliegt.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/sgb_9_2018/__178.html\",\"fassung_datum\":\"Konsolidierte Onlinefassung, abgerufen am 21.10.2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 6 Abs. 1 Buchst. e\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Das Versenden einer Einladung unter Verwendung von Bewerberdaten ist eine Verarbeitung personenbezogener Daten. Für eine öffentliche Hochschule kommt hierfür die Erforderlichkeit zur Wahrnehmung einer Aufgabe im öffentlichen Interesse beziehungsweise in Ausübung öffentlicher Gewalt als Rechtsgrundlage in Betracht.\",\"quelle_url\":\"https://eur-lex.europa.eu/eli/reg/2016/679/oj\",\"fassung_datum\":\"Geltende Onlinefassung, abgerufen am 21.10.2026\",\"sicherheit\":\"sicher\"}]}",
          "type": "output_text",
          "logprobs": [],
          "parsed": {
            "funde": [
              {
                "regelwerk": "BayGlG",
                "fundstelle": "Art. 17 Abs. 3 Satz 4",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Die Einladung muss spätestens auf das Antragsrecht zur Beteiligung der Gleichstellungsbeauftragten am Vorstellungsgespräch hinweisen.",
                "begruendung": "Die Vorschrift verlangt ausdrücklich, dass auf das Antragsrecht spätestens im Rahmen der Einladung zum Vorstellungsgespräch hingewiesen wird.",
                "quelle_url": "https://www.gesetze-bayern.de/Content/Document/BayGlG-17",
                "fassung_datum": "Text gilt ab 01.04.2026",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "SGB IX",
                "fundstelle": "§ 165",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Schwerbehinderte Bewerberinnen und Bewerber sind zum Vorstellungsgespräch einzuladen, sofern ihre fachliche Eignung nicht offensichtlich fehlt.",
                "begruendung": "Als öffentlicher Arbeitgeber muss die Hochschule die besondere Einladungspflicht bei Bewerbungen schwerbehinderter Menschen beachten.",
                "quelle_url": "https://www.gesetze-im-internet.de/sgb_9_2018/__165.html",
                "fassung_datum": "Konsolidierte Onlinefassung, abgerufen am 21.10.2026",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "SGB IX",
                "fundstelle": "§ 178 Abs. 2",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Bei Bewerbungen schwerbehinderter Menschen ist die Schwerbehindertenvertretung grundsätzlich zu beteiligen; sie hat insbesondere das Recht, an Vorstellungsgesprächen teilzunehmen. Eine Beteiligung unterbleibt, wenn die betroffene Person sie ausdrücklich ablehnt.",
                "begruendung": "Die Einladung und Vorbereitung des Gesprächs muss die gesetzlichen Beteiligungs- und Teilnahmerechte der Schwerbehindertenvertretung berücksichtigen, sofern eine Bewerbung eines schwerbehinderten Menschen vorliegt.",
                "quelle_url": "https://www.gesetze-im-internet.de/sgb_9_2018/__178.html",
                "fassung_datum": "Konsolidierte Onlinefassung, abgerufen am 21.10.2026",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "DSGVO",
                "fundstelle": "Art. 6 Abs. 1 Buchst. e",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": null,
                "begruendung": "Das Versenden einer Einladung unter Verwendung von Bewerberdaten ist eine Verarbeitung personenbezogener Daten. Für eine öffentliche Hochschule kommt hierfür die Erforderlichkeit zur Wahrnehmung einer Aufgabe im öffentlichen Interesse beziehungsweise in Ausübung öffentlicher Gewalt als Rechtsgrundlage in Betracht.",
                "quelle_url": "https://eur-lex.europa.eu/eli/reg/2016/679/oj",
                "fassung_datum": "Geltende Onlinefassung, abgerufen am 21.10.2026",
                "sicherheit": "sicher"
              }
            ]
