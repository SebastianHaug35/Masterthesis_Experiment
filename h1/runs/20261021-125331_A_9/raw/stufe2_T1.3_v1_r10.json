          "annotations": [],
          "text": "{\"funde\":[{\"regelwerk\":\"AGG\",\"fundstelle\":\"§ 11\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Stellenausschreibung muss diskriminierungsfrei sein; § 11 verweist hierfür auf das Benachteiligungsverbot des § 7 Abs. 1 AGG.\",\"begruendung\":\"Bei der Veröffentlichung der Stelle darf die Ausschreibung nicht gegen das Benachteiligungsverbot verstoßen.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/agg/__11.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 15 G v. 22.12.2023 I Nr. 414\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"AGG\",\"fundstelle\":\"§ 7 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Ausschreibung darf keine Benachteiligung wegen eines in § 1 AGG genannten Grundes bewirken oder nahelegen.\",\"begruendung\":\"Das Benachteiligungsverbot gilt für Beschäftigte und damit auch für den Zugang zu einer ausgeschriebenen Stelle; es ist bei der Formulierung und Veröffentlichung zu beachten.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/agg/__7.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 15 G v. 22.12.2023 I Nr. 414\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"BayGlG\",\"fundstelle\":\"Art. 7\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Zu beachten sind insbesondere die männliche und weibliche Form der Berufsbezeichnung, der Hinweis auf Teilzeitbeschäftigungsmöglichkeiten und die Aufforderung an das in erheblich geringerer Zahl beschäftigte Geschlecht, sich zu bewerben.\",\"begruendung\":\"Die Vorschrift regelt unmittelbar die geschlechtsbezogenen Anforderungen an Stellenausschreibungen im bayerischen öffentlichen Dienst.\",\"quelle_url\":\"https://www.gesetze-bayern.de/Content/Document/BayGlG-7\",\"fassung_datum\":\"Text gilt ab 01.04.2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"GG\",\"fundstelle\":\"Art. 33 Abs. 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Als staatliche Hochschule muss die Ausschreibung den gleichen Zugang zum öffentlichen Amt nach Eignung, Befähigung und fachlicher Leistung ermöglichen.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/gg/art_33.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 1 G v. 22.3.2025 I Nr. 94\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"SGB IX\",\"fundstelle\":\"§ 165\",\"typ\":\"moegliche_luecke\",\"fehlender_schritt\":\"Freie und neu zu besetzende Arbeitsplätze nach erfolgloser Prüfung einer internen Besetzung frühzeitig der Agentur für Arbeit melden; dieser Prozessschritt ist in den aufgeführten Tasks nicht ausdrücklich benannt.\",\"hinweis\":null,\"begruendung\":\"Öffentliche Arbeitgeber müssen die erfassten Arbeitsplätze frühzeitig der Agentur für Arbeit melden. Die Meldung ist ein eigenständiger Schritt und wird durch die beschriebenen Aufgaben zur internen und externen Veröffentlichung nicht ausdrücklich abgedeckt.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/sgb_9_2018/__165.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 2b G v. 24.7.2026 I Nr. 228\",\"sicherheit\":\"sicher\"}]}",
          "type": "output_text",
