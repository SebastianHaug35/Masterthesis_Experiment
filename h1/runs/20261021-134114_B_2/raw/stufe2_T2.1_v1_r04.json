          "annotations": [],
          "text": "{\"funde\":[{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 5 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Beim Empfang und der Speicherung sind insbesondere Zweckbindung, Datenminimierung, Richtigkeit, Speicherbegrenzung sowie Integrität und Vertraulichkeit einzuhalten.\",\"begruendung\":\"Die Grundsätze gelten für die Verarbeitung personenbezogener Bewerbungsdaten über das Portal.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_5\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 5 Abs. 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Hochschule muss die Einhaltung der Datenschutzgrundsätze nachweisen können.\",\"begruendung\":\"Die Rechenschaftspflicht erstreckt sich auf die Erhebung und Verarbeitung der Bewerbungsdaten im Portal.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_5\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 6 Abs. 1 Buchst. e\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Hochschule muss die für die Verarbeitung einschlägige Rechtsgrundlage des öffentlichen Auftrags bestimmen.\",\"begruendung\":\"Für die Verarbeitung im Rahmen der Bewerbungsannahme durch eine staatliche Hochschule kommt die Erforderlichkeit zur Wahrnehmung einer Aufgabe im öffentlichen Interesse in Betracht.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_6\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"unsicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 6 Abs. 3\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Für eine Rechtsgrundlage nach Art. 6 Abs. 1 Buchst. e muss die einschlägige unions- oder mitgliedstaatliche Rechtsgrundlage zugrunde gelegt werden.\",\"begruendung\":\"Die Rechtmäßigkeit der Verarbeitung durch die öffentliche Hochschule setzt bei Berufung auf die öffentliche Aufgabe eine hinreichend bestimmte Rechtsgrundlage voraus.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_6\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 13 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Bewerbenden sind zum Zeitpunkt der Erhebung unter anderem über Verantwortlichen, Datenschutzbeauftragten, Zwecke, Rechtsgrundlage und gegebenenfalls Empfänger zu informieren; dies kann über einen bei der Bewerbung zugänglichen Datenschutzhinweis erfolgen.\",\"begruendung\":\"Die Bewerbungsdaten werden bei den betroffenen Personen selbst erhoben.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_13\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 13 Abs. 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Der Datenschutzhinweis muss außerdem die weiteren Informationen nach Absatz 2 enthalten, insbesondere Speicherdauer oder deren Kriterien sowie die Betroffenenrechte und Beschwerdemöglichkeit.\",\"begruendung\":\"Auch diese Informationspflicht gilt, wenn Bewerbungsdaten über das Portal direkt bei den Bewerbenden erhoben werden.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_13\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 25 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Das Portal ist mit geeigneten technischen und organisatorischen Maßnahmen datenschutzgerecht auszugestalten; insbesondere sind die Datenschutzgrundsätze wirksam umzusetzen.\",\"begruendung\":\"Die Vorschrift gilt sowohl bei der Festlegung der Mittel als auch bei der Verarbeitung der Bewerbungsdaten über das Portal.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_25\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 25 Abs. 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Voreinstellungen des Portals müssen die erhobenen Daten, Zugänglichkeit und Speicherdauer auf das für den Bewerbungszweck Erforderliche begrenzen.\",\"begruendung\":\"Die datenschutzfreundlichen Voreinstellungen betreffen auch die Erhebung und Ablage eingehender Bewerbungen.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_25\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 32 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Für das Portal und die dort gespeicherten Bewerbungsunterlagen sind risikogerechte technische und organisatorische Sicherheitsmaßnahmen festzulegen und anzuwenden.\",\"begruendung\":\"Die Hochschule und gegebenenfalls ein Auftragsverarbeiter müssen ein dem Risiko angemessenes Schutzniveau für die übermittelten und gespeicherten Bewerbungsdaten gewährleisten.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_32\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"}]}",
