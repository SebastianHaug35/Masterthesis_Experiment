          "annotations": [],
          "text": "{\"funde\":[{\"regelwerk\":\"AGG\",\"fundstelle\":\"§ 7 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Die Absage darf Bewerbende nicht wegen eines in § 1 AGG genannten Grundes benachteiligen.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/agg/__7.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 15 G v. 22.12.2023 I Nr. 414\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"AGG\",\"fundstelle\":\"§ 15 Abs. 4\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die zweimonatige Frist für die schriftliche Geltendmachung von Ansprüchen beginnt bei einer Bewerbung mit Zugang der Ablehnung. Eine Pflicht, in der Absage auf die Frist hinzuweisen, ergibt sich aus der Vorschrift nicht.\",\"begruendung\":\"Der Zugang der Absage setzt die gesetzliche Frist für mögliche Entschädigungs- oder Schadensersatzansprüche in Gang; der Zeitpunkt des Zugangs sollte daher nachvollziehbar sein.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/agg/__15.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 15 G v. 22.12.2023 I Nr. 414\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"AGG\",\"fundstelle\":\"§ 22\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Bei Indizien für eine Benachteiligung muss der Arbeitgeber darlegen und beweisen, dass kein Verstoß vorlag; Auswahlgründe und Entscheidungsgrundlage sollten daher nachvollziehbar dokumentiert sein. Die Prozessschritte zur Prüfung und Dokumentation sind im Gesamtprozess bereits vorgesehen.\",\"begruendung\":\"Die Norm regelt die Beweislast in Streitfällen wegen möglicher Benachteiligung und ist für die Absage als Mitteilung der Auswahlentscheidung relevant.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/agg/__22.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 15 G v. 22.12.2023 I Nr. 414\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 5 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Absage sollte nur erforderliche personenbezogene Angaben enthalten und so versandt werden, dass sie nicht unbefugten Dritten offengelegt werden.\",\"begruendung\":\"Beim Erstellen und Versenden der Absage werden personenbezogene Bewerbungsdaten verarbeitet; dabei sind insbesondere Rechtmäßigkeit, Datenminimierung sowie Integrität und Vertraulichkeit zu beachten.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_5\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"}]}",
          "type": "output_text",
          "logprobs": [],
          "parsed": {
            "funde": [
              {
                "regelwerk": "AGG",
                "fundstelle": "§ 7 Abs. 1",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": null,
                "begruendung": "Die Absage darf Bewerbende nicht wegen eines in § 1 AGG genannten Grundes benachteiligen.",
                "quelle_url": "https://www.gesetze-im-internet.de/agg/__7.html",
                "fassung_datum": "Stand Zuletzt geändert durch Art. 15 G v. 22.12.2023 I Nr. 414",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "AGG",
                "fundstelle": "§ 15 Abs. 4",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Die zweimonatige Frist für die schriftliche Geltendmachung von Ansprüchen beginnt bei einer Bewerbung mit Zugang der Ablehnung. Eine Pflicht, in der Absage auf die Frist hinzuweisen, ergibt sich aus der Vorschrift nicht.",
                "begruendung": "Der Zugang der Absage setzt die gesetzliche Frist für mögliche Entschädigungs- oder Schadensersatzansprüche in Gang; der Zeitpunkt des Zugangs sollte daher nachvollziehbar sein.",
                "quelle_url": "https://www.gesetze-im-internet.de/agg/__15.html",
                "fassung_datum": "Stand Zuletzt geändert durch Art. 15 G v. 22.12.2023 I Nr. 414",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "AGG",
                "fundstelle": "§ 22",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Bei Indizien für eine Benachteiligung muss der Arbeitgeber darlegen und beweisen, dass kein Verstoß vorlag; Auswahlgründe und Entscheidungsgrundlage sollten daher nachvollziehbar dokumentiert sein. Die Prozessschritte zur Prüfung und Dokumentation sind im Gesamtprozess bereits vorgesehen.",
                "begruendung": "Die Norm regelt die Beweislast in Streitfällen wegen möglicher Benachteiligung und ist für die Absage als Mitteilung der Auswahlentscheidung relevant.",
                "quelle_url": "https://www.gesetze-im-internet.de/agg/__22.html",
                "fassung_datum": "Stand Zuletzt geändert durch Art. 15 G v. 22.12.2023 I Nr. 414",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "DSGVO",
                "fundstelle": "Art. 5 Abs. 1",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Die Absage sollte nur erforderliche personenbezogene Angaben enthalten und so versandt werden, dass sie nicht unbefugten Dritten offengelegt werden.",
                "begruendung": "Beim Erstellen und Versenden der Absage werden personenbezogene Bewerbungsdaten verarbeitet; dabei sind insbesondere Rechtmäßigkeit, Datenminimierung sowie Integrität und Vertraulichkeit zu beachten.",
                "quelle_url": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_5",
                "fassung_datum": "konsolidierte Fassung vom 04.05.2016",
                "sicherheit": "sicher"
              }
            ]
