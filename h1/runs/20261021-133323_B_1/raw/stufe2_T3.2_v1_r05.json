          "annotations": [],
          "text": "{\"funde\":[{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 5 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Beim Erzeugen des Rankings sind insbesondere Zweckbindung, Datenminimierung, Richtigkeit sowie Transparenz und Vertraulichkeit zu beachten. Die Hochschule muss die Einhaltung nach Art. 5 Abs. 2 nachweisen können.\",\"begruendung\":\"Das Ranking verarbeitet personenbezogene Bewerbungsdaten. Die Grundsätze gelten daher auch für deren Auswertung und Bewertung durch das KI-Tool.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_5\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 6 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Für die Verarbeitung muss eine einschlägige Rechtsgrundlage feststehen. Bei einer Verarbeitung als öffentliche Stelle im Rahmen ihrer Aufgaben kommt insbesondere Art. 6 Abs. 1 Buchst. e in Betracht; die Rechtsgrundlage muss die Anforderungen des Art. 6 Abs. 3 erfüllen. Art. 6 Abs. 1 Buchst. f gilt nicht für Behörden bei der Erfüllung ihrer Aufgaben.\",\"begruendung\":\"Das Erzeugen eines Rankings anhand von Bewerbungsdaten ist eine Verarbeitung personenbezogener Daten und bedarf einer Rechtsgrundlage.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_6\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"}]}",
          "type": "output_text",
          "logprobs": [],
          "parsed": {
            "funde": [
              {
                "regelwerk": "DSGVO",
                "fundstelle": "Art. 5 Abs. 1",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Beim Erzeugen des Rankings sind insbesondere Zweckbindung, Datenminimierung, Richtigkeit sowie Transparenz und Vertraulichkeit zu beachten. Die Hochschule muss die Einhaltung nach Art. 5 Abs. 2 nachweisen können.",
                "begruendung": "Das Ranking verarbeitet personenbezogene Bewerbungsdaten. Die Grundsätze gelten daher auch für deren Auswertung und Bewertung durch das KI-Tool.",
                "quelle_url": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_5",
                "fassung_datum": "konsolidierte Fassung vom 04.05.2016",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "DSGVO",
                "fundstelle": "Art. 6 Abs. 1",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Für die Verarbeitung muss eine einschlägige Rechtsgrundlage feststehen. Bei einer Verarbeitung als öffentliche Stelle im Rahmen ihrer Aufgaben kommt insbesondere Art. 6 Abs. 1 Buchst. e in Betracht; die Rechtsgrundlage muss die Anforderungen des Art. 6 Abs. 3 erfüllen. Art. 6 Abs. 1 Buchst. f gilt nicht für Behörden bei der Erfüllung ihrer Aufgaben.",
                "begruendung": "Das Erzeugen eines Rankings anhand von Bewerbungsdaten ist eine Verarbeitung personenbezogener Daten und bedarf einer Rechtsgrundlage.",
                "quelle_url": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_6",
