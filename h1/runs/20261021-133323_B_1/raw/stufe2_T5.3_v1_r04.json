          "annotations": [],
          "text": "{\"funde\":[{\"regelwerk\":\"TV-L\",\"fundstelle\":\"§ 2 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Der Arbeitsvertrag ist nach dieser Vorschrift schriftlich abzuschließen.\",\"quelle_url\":\"https://www.tdl-online.de/fileadmin/downloads/TV-L/260812_TV-L__i.d.F._des_%C3%84TV_Nr._14_VT_neu.pdf\",\"fassung_datum\":\"i. d. F. des ÄTV Nr. 14 vom 14. Februar 2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"TV-L\",\"fundstelle\":\"§ 12 Abs. 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Entgeltgruppe muss im Arbeitsvertrag angegeben werden.\",\"begruendung\":\"Bei Abschluss des Arbeitsvertrags ist die Entgeltgruppe der beschäftigten Person im Vertrag anzugeben.\",\"quelle_url\":\"https://www.tdl-online.de/fileadmin/downloads/TV-L/260812_TV-L__i.d.F._des_%C3%84TV_Nr._14_VT_neu.pdf\",\"fassung_datum\":\"i. d. F. des ÄTV Nr. 14 vom 14. Februar 2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"WissZeitVG\",\"fundstelle\":\"§ 2 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Befristungsdauer muss der angestrebten Qualifizierung angemessen sein. Vor Abschluss sind außerdem die für die zulässige Höchstdauer anzurechnenden Vorbeschäftigungs- und Promotionszeiten zu prüfen; aus den Angaben im Task lässt sich das nicht beurteilen.\",\"begruendung\":\"Für nicht promoviertes wissenschaftliches Personal ist eine Befristung zur Förderung der eigenen wissenschaftlichen Qualifizierung innerhalb der gesetzlichen Höchstdauer zulässig. Die Dauer von drei Jahren ist an der angestrebten Qualifizierung auszurichten.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/wisszeitvg/__2.html\",\"fassung_datum\":\"Stand Zuletzt geändert Art. 1 G v. 25.5.2020 I 1073\",\"sicherheit\":\"unsicher\"},{\"regelwerk\":\"WissZeitVG\",\"fundstelle\":\"§ 2 Abs. 4\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Im Arbeitsvertrag muss angegeben werden, dass die Befristung auf dem WissZeitVG beruht; ihre Dauer muss kalendermäßig bestimmt oder bestimmbar sein.\",\"begruendung\":\"Diese Vorschrift stellt für die Befristung nach dem WissZeitVG Anforderungen an den Inhalt des abzuschließenden Arbeitsvertrags.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/wisszeitvg/__2.html\",\"fassung_datum\":\"Stand Zuletzt geändert Art. 1 G v. 25.5.2020 I 1073\",\"sicherheit\":\"sicher\"}]}",
          "type": "output_text",
          "logprobs": [],
          "parsed": {
            "funde": [
              {
                "regelwerk": "TV-L",
                "fundstelle": "§ 2 Abs. 1",
