          "annotations": [],
          "text": "{\"funde\":[{\"regelwerk\":\"AI Act\",\"fundstelle\":\"Art. 14 Abs. 4\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Bei der fachlichen Prüfung des KI-Rankings muss die menschliche Aufsicht wirksam ausgeübt werden. Die prüfende Person muss insbesondere die Grenzen und mögliche Fehler des Systems verstehen, Automatisierungsbias vermeiden, die Ausgabe richtig interpretieren und sie nötigenfalls außer Acht lassen oder außer Kraft setzen können.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02024R1689-20260727#art_14\",\"fassung_datum\":\"konsolidierte Fassung vom 27.07.2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"AI Act\",\"fundstelle\":\"Art. 26 Abs. 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Die Hochschule muss die menschliche Aufsicht Personen übertragen, die über die erforderliche Kompetenz, Ausbildung und Befugnis verfügen, und ihnen die nötige Unterstützung gewähren. Das betrifft die für die Prüfung des KI-Ergebnisses verantwortliche Fachabteilung.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02024R1689-20260727#art_26\",\"fassung_datum\":\"konsolidierte Fassung vom 27.07.2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"AI Act\",\"fundstelle\":\"Art. 26 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Prüfung ist entsprechend den dem KI-System beigefügten Betriebsanleitungen und den einschlägigen Betreiberpflichten durchzuführen.\",\"begruendung\":\"Bei der Verwendung des Hochrisiko-KI-Systems zur Vorauswahl muss die Hochschule geeignete technische und organisatorische Maßnahmen treffen, damit das System gemäß seinen Betriebsanleitungen verwendet wird.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02024R1689-20260727#art_26\",\"fassung_datum\":\"konsolidierte Fassung vom 27.07.2026\",\"sicherheit\":\"sicher\"}]}",
          "type": "output_text",
          "logprobs": [],
          "parsed": {
            "funde": [
              {
                "regelwerk": "AI Act",
                "fundstelle": "Art. 14 Abs. 4",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": null,
                "begruendung": "Bei der fachlichen Prüfung des KI-Rankings muss die menschliche Aufsicht wirksam ausgeübt werden. Die prüfende Person muss insbesondere die Grenzen und mögliche Fehler des Systems verstehen, Automatisierungsbias vermeiden, die Ausgabe richtig interpretieren und sie nötigenfalls außer Acht lassen oder außer Kraft setzen können.",
                "quelle_url": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02024R1689-20260727#art_14",
                "fassung_datum": "konsolidierte Fassung vom 27.07.2026",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "AI Act",
                "fundstelle": "Art. 26 Abs. 2",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": null,
                "begruendung": "Die Hochschule muss die menschliche Aufsicht Personen übertragen, die über die erforderliche Kompetenz, Ausbildung und Befugnis verfügen, und ihnen die nötige Unterstützung gewähren. Das betrifft die für die Prüfung des KI-Ergebnisses verantwortliche Fachabteilung.",
                "quelle_url": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02024R1689-20260727#art_26",
                "fassung_datum": "konsolidierte Fassung vom 27.07.2026",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "AI Act",
                "fundstelle": "Art. 26 Abs. 1",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Die Prüfung ist entsprechend den dem KI-System beigefügten Betriebsanleitungen und den einschlägigen Betreiberpflichten durchzuführen.",
                "begruendung": "Bei der Verwendung des Hochrisiko-KI-Systems zur Vorauswahl muss die Hochschule geeignete technische und organisatorische Maßnahmen treffen, damit das System gemäß seinen Betriebsanleitungen verwendet wird.",
                "quelle_url": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02024R1689-20260727#art_26",
                "fassung_datum": "konsolidierte Fassung vom 27.07.2026",
