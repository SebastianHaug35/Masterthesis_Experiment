          "annotations": [],
          "text": "{\"funde\":[{\"regelwerk\":\"TV-L\",\"fundstelle\":\"§ 12 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Eingruppierung ist anhand der Tätigkeitsmerkmale der Entgeltordnung (Anlage A) und der gesamten nicht nur vorübergehend auszuübenden Tätigkeit festzulegen; maßgeblich sind insbesondere die Arbeitsvorgänge und die zeitlichen Anteile. Eine konkrete Entgeltgruppe lässt sich ohne nähere Angaben zu den Aufgaben nicht bestimmen.\",\"begruendung\":\"Die Vorschrift bestimmt unmittelbar, nach welchen Tätigkeitsmerkmalen die Eingruppierung vorzunehmen ist. Die Festlegung des Stellenprofils muss daher die tatsächlich auszuübenden Tätigkeiten so beschreiben, dass die tarifliche Bewertung möglich ist.\",\"quelle_url\":\"https://www.tdl-online.de/fileadmin/downloads/TV-L/260812_TV-L__i.d.F._des_%C3%84TV_Nr._14_VT_neu.pdf\",\"fassung_datum\":\"i. d. F. des ÄTV Nr. 14 vom 14. Februar 2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"AGG\",\"fundstelle\":\"§ 7 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Bei der Festlegung des Stellenprofils und der Anforderungen dürfen Bewerbende nicht wegen eines in § 1 AGG genannten Grundes benachteiligt werden.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/agg/__7.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 15 G v. 22.12.2023 I Nr. 414\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"GG\",\"fundstelle\":\"Art. 3 Abs. 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Als staatliche Hochschule muss die Organisation bei der Festlegung des Stellenprofils und der Auswahlvoraussetzungen die Gleichberechtigung von Frauen und Männern beachten und tatsächliche Nachteile vermeiden.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/gg/art_3.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 1 G v. 22.3.2025 I Nr. 94\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"GG\",\"fundstelle\":\"Art. 3 Abs. 3\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":null,\"begruendung\":\"Die staatliche Hochschule muss bei der Festlegung der Anforderungen Benachteiligungen insbesondere wegen Geschlecht, Herkunft, Religion oder Behinderung vermeiden.\",\"quelle_url\":\"https://www.gesetze-im-internet.de/gg/art_3.html\",\"fassung_datum\":\"Stand Zuletzt geändert durch Art. 1 G v. 22.3.2025 I Nr. 94\",\"sicherheit\":\"sicher\"}]}",
          "type": "output_text",
          "logprobs": [],
          "parsed": {
            "funde": [
              {
                "regelwerk": "TV-L",
                "fundstelle": "§ 12 Abs. 1",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Die Eingruppierung ist anhand der Tätigkeitsmerkmale der Entgeltordnung (Anlage A) und der gesamten nicht nur vorübergehend auszuübenden Tätigkeit festzulegen; maßgeblich sind insbesondere die Arbeitsvorgänge und die zeitlichen Anteile. Eine konkrete Entgeltgruppe lässt sich ohne nähere Angaben zu den Aufgaben nicht bestimmen.",
                "begruendung": "Die Vorschrift bestimmt unmittelbar, nach welchen Tätigkeitsmerkmalen die Eingruppierung vorzunehmen ist. Die Festlegung des Stellenprofils muss daher die tatsächlich auszuübenden Tätigkeiten so beschreiben, dass die tarifliche Bewertung möglich ist.",
                "quelle_url": "https://www.tdl-online.de/fileadmin/downloads/TV-L/260812_TV-L__i.d.F._des_%C3%84TV_Nr._14_VT_neu.pdf",
                "fassung_datum": "i. d. F. des ÄTV Nr. 14 vom 14. Februar 2026",
                "sicherheit": "sicher"
