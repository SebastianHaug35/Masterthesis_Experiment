          "annotations": [],
          "text": "{\"funde\":[{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 5 Abs. 1 Buchst. e\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Bewerberdaten dürfen nur so lange identifizierbar gespeichert werden, wie sie für den Zweck erforderlich sind; danach sind sie zu löschen.\",\"begruendung\":\"Der Grundsatz der Speicherbegrenzung verpflichtet dazu, Bewerberdaten nach Wegfall des Speicherzwecks zu löschen.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_5\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 5 Abs. 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Hochschule muss die Einhaltung der Speicherbegrenzung und die ordnungsgemäße Löschung nachweisen können.\",\"begruendung\":\"Die Rechenschaftspflicht verpflichtet den Verantwortlichen, die Einhaltung der Datenschutzgrundsätze nachzuweisen.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_5\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 17 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Bei Wegfall des Verarbeitungszwecks sind die Daten unverzüglich zu löschen, sofern kein Ausnahmegrund greift; das Löschrecht besteht außerdem auf Antrag, wenn eine der gesetzlichen Voraussetzungen vorliegt.\",\"begruendung\":\"Die Vorschrift begründet die Löschpflicht insbesondere, wenn personenbezogene Daten für die Zwecke ihrer Verarbeitung nicht mehr notwendig sind.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_17\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 17 Abs. 3 Buchst. e\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Vor der Löschung ist zu prüfen, ob eine weitere Speicherung im Einzelfall zur Geltendmachung, Ausübung oder Verteidigung von Rechtsansprüchen erforderlich ist.\",\"begruendung\":\"Die Löschpflicht gilt nicht, soweit eine Speicherung für Rechtsansprüche erforderlich ist; dies kann insbesondere bei noch offenen Ansprüchen aus dem Bewerbungsverfahren relevant sein.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_17\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"DSGVO\",\"fundstelle\":\"Art. 19\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Falls Bewerberdaten Empfängern offengelegt wurden, sind diese über die Löschung zu unterrichten, sofern dies nicht unmöglich oder unverhältnismäßig ist.\",\"begruendung\":\"Die Vorschrift verlangt die Mitteilung der Löschung an Empfänger, denen die personenbezogenen Daten offengelegt wurden.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_19\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"}]}",
          "type": "output_text",
          "logprobs": [],
          "parsed": {
            "funde": [
              {
                "regelwerk": "DSGVO",
                "fundstelle": "Art. 5 Abs. 1 Buchst. e",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Bewerberdaten dürfen nur so lange identifizierbar gespeichert werden, wie sie für den Zweck erforderlich sind; danach sind sie zu löschen.",
                "begruendung": "Der Grundsatz der Speicherbegrenzung verpflichtet dazu, Bewerberdaten nach Wegfall des Speicherzwecks zu löschen.",
                "quelle_url": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_5",
                "fassung_datum": "konsolidierte Fassung vom 04.05.2016",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "DSGVO",
                "fundstelle": "Art. 5 Abs. 2",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Die Hochschule muss die Einhaltung der Speicherbegrenzung und die ordnungsgemäße Löschung nachweisen können.",
                "begruendung": "Die Rechenschaftspflicht verpflichtet den Verantwortlichen, die Einhaltung der Datenschutzgrundsätze nachzuweisen.",
                "quelle_url": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_5",
                "fassung_datum": "konsolidierte Fassung vom 04.05.2016",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "DSGVO",
                "fundstelle": "Art. 17 Abs. 1",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Bei Wegfall des Verarbeitungszwecks sind die Daten unverzüglich zu löschen, sofern kein Ausnahmegrund greift; das Löschrecht besteht außerdem auf Antrag, wenn eine der gesetzlichen Voraussetzungen vorliegt.",
                "begruendung": "Die Vorschrift begründet die Löschpflicht insbesondere, wenn personenbezogene Daten für die Zwecke ihrer Verarbeitung nicht mehr notwendig sind.",
                "quelle_url": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_17",
                "fassung_datum": "konsolidierte Fassung vom 04.05.2016",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "DSGVO",
                "fundstelle": "Art. 17 Abs. 3 Buchst. e",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Vor der Löschung ist zu prüfen, ob eine weitere Speicherung im Einzelfall zur Geltendmachung, Ausübung oder Verteidigung von Rechtsansprüchen erforderlich ist.",
                "begruendung": "Die Löschpflicht gilt nicht, soweit eine Speicherung für Rechtsansprüche erforderlich ist; dies kann insbesondere bei noch offenen Ansprüchen aus dem Bewerbungsverfahren relevant sein.",
                "quelle_url": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_17",
                "fassung_datum": "konsolidierte Fassung vom 04.05.2016",
                "sicherheit": "sicher"
