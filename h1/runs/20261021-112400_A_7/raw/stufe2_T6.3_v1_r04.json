                "fehlender_schritt": null,
                "hinweis": null,
                "begruendung": "Sind Bewerberdaten für die Zwecke, für die sie erhoben oder verarbeitet wurden, nicht mehr notwendig, besteht grundsätzlich eine Pflicht zur unverzüglichen Löschung.",
                "quelle_url": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_17",
