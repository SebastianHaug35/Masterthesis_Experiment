          "annotations": [],
          "text": "{\"funde\":[{\"regelwerk\":\"TV-L\",\"fundstelle\":\"§ 2 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Der TV-L verlangt den schriftlichen Abschluss des Arbeitsvertrags. Das Vertragsangebot sollte daher für den späteren schriftlichen Vertrag vorbereitet werden; das Erstellen des Angebots allein erfüllt die Schriftform noch nicht.\",\"begruendung\":\"Die Vertragsbedingungen werden im Angebot vorbereitet. Für den späteren Abschluss des Arbeitsvertrags schreibt der Tarifvertrag Schriftform vor.\",\"quelle_url\":\"https://www.tdl-online.de/fileadmin/downloads/TV-L/260812_TV-L__i.d.F._des_%C3%84TV_Nr._14_VT_neu.pdf\",\"fassung_datum\":\"i. d. F. des ÄTV Nr. 14 vom 14. Februar 2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"TV-L\",\"fundstelle\":\"§ 12 Abs. 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Entgeltgruppe muss im Arbeitsvertrag angegeben werden; sie sollte daher im Angebot korrekt ausgewiesen sein.\",\"begruendung\":\"Das Angebot für die TV-L-Stelle bereitet die Festlegung der tariflichen Eingruppierung vor. Der Tarifvertrag verlangt, dass die Entgeltgruppe im Arbeitsvertrag angegeben wird.\",\"quelle_url\":\"https://www.tdl-online.de/fileadmin/downloads/TV-L/260812_TV-L__i.d.F._des_%C3%84TV_Nr._14_VT_neu.pdf\",\"fassung_datum\":\"i. d. F. des ÄTV Nr. 14 vom 14. Februar 2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"TV-L\",\"fundstelle\":\"§ 16 Abs. 2\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Stufenzuordnung ist anhand der einschlägigen Berufserfahrung und der tariflichen Voraussetzungen zu prüfen; die konkrete Stufe sollte im Angebot zutreffend berücksichtigt werden.\",\"begruendung\":\"Die tarifliche Stufe beeinflusst das Entgelt und ist deshalb bei der Erstellung des Angebots für die einzustellende Person zu berücksichtigen.\",\"quelle_url\":\"https://www.tdl-online.de/fileadmin/downloads/TV-L/260812_TV-L__i.d.F._des_%C3%84TV_Nr._14_VT_neu.pdf\",\"fassung_datum\":\"i. d. F. des ÄTV Nr. 14 vom 14. Februar 2026\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"TV-L\",\"fundstelle\":\"§ 30 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Die Befristung muss auf einer gesetzlichen Grundlage beruhen. Die konkrete Befristungsdauer von drei Jahren ist im Angebot entsprechend der einschlägigen Befristungsvorschriften zu formulieren.\",\"begruendung\":\"Der Task betrifft das Angebot für eine als befristet beschriebene Beschäftigung. Der TV-L verweist für die Zulässigkeit befristeter Arbeitsverträge auf das Teilzeit- und Befristungsgesetz sowie andere gesetzliche Befristungsvorschriften.\",\"quelle_url\":\"https://www.tdl-online.de/fileadmin/downloads/TV-L/260812_TV-L__i.d.F._des_%C3%84TV_Nr._14_VT_neu.pdf\",\"fassung_datum\":\"i. d. F. des ÄTV Nr. 14 vom 14. Februar 2026\",\"sicherheit\":\"sicher\"}]}",
          "type": "output_text",
          "logprobs": [],
          "parsed": {
            "funde": [
              {
                "regelwerk": "TV-L",
                "fundstelle": "§ 2 Abs. 1",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Der TV-L verlangt den schriftlichen Abschluss des Arbeitsvertrags. Das Vertragsangebot sollte daher für den späteren schriftlichen Vertrag vorbereitet werden; das Erstellen des Angebots allein erfüllt die Schriftform noch nicht.",
                "begruendung": "Die Vertragsbedingungen werden im Angebot vorbereitet. Für den späteren Abschluss des Arbeitsvertrags schreibt der Tarifvertrag Schriftform vor.",
                "quelle_url": "https://www.tdl-online.de/fileadmin/downloads/TV-L/260812_TV-L__i.d.F._des_%C3%84TV_Nr._14_VT_neu.pdf",
                "fassung_datum": "i. d. F. des ÄTV Nr. 14 vom 14. Februar 2026",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "TV-L",
                "fundstelle": "§ 12 Abs. 2",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Die Entgeltgruppe muss im Arbeitsvertrag angegeben werden; sie sollte daher im Angebot korrekt ausgewiesen sein.",
                "begruendung": "Das Angebot für die TV-L-Stelle bereitet die Festlegung der tariflichen Eingruppierung vor. Der Tarifvertrag verlangt, dass die Entgeltgruppe im Arbeitsvertrag angegeben wird.",
                "quelle_url": "https://www.tdl-online.de/fileadmin/downloads/TV-L/260812_TV-L__i.d.F._des_%C3%84TV_Nr._14_VT_neu.pdf",
                "fassung_datum": "i. d. F. des ÄTV Nr. 14 vom 14. Februar 2026",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "TV-L",
                "fundstelle": "§ 16 Abs. 2",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Die Stufenzuordnung ist anhand der einschlägigen Berufserfahrung und der tariflichen Voraussetzungen zu prüfen; die konkrete Stufe sollte im Angebot zutreffend berücksichtigt werden.",
                "begruendung": "Die tarifliche Stufe beeinflusst das Entgelt und ist deshalb bei der Erstellung des Angebots für die einzustellende Person zu berücksichtigen.",
                "quelle_url": "https://www.tdl-online.de/fileadmin/downloads/TV-L/260812_TV-L__i.d.F._des_%C3%84TV_Nr._14_VT_neu.pdf",
                "fassung_datum": "i. d. F. des ÄTV Nr. 14 vom 14. Februar 2026",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "TV-L",
                "fundstelle": "§ 30 Abs. 1",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Die Befristung muss auf einer gesetzlichen Grundlage beruhen. Die konkrete Befristungsdauer von drei Jahren ist im Angebot entsprechend der einschlägigen Befristungsvorschriften zu formulieren.",
                "begruendung": "Der Task betrifft das Angebot für eine als befristet beschriebene Beschäftigung. Der TV-L verweist für die Zulässigkeit befristeter Arbeitsverträge auf das Teilzeit- und Befristungsgesetz sowie andere gesetzliche Befristungsvorschriften.",
                "quelle_url": "https://www.tdl-online.de/fileadmin/downloads/TV-L/260812_TV-L__i.d.F._des_%C3%84TV_Nr._14_VT_neu.pdf",
