          "annotations": [],
          "text": "{\"funde\":[{\"regelwerk\":\"Verordnung (EU) 2016/679\",\"fundstelle\":\"Art. 5 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Bei der KI-Auswertung sind insbesondere Zweckbindung, Datenminimierung, Richtigkeit, Speicherbegrenzung sowie Integrität und Vertraulichkeit einzuhalten; die Hochschule muss die Einhaltung nachweisen können.\",\"begruendung\":\"Die Auswertung von Bewerbungsunterlagen mit einem KI-Tool verarbeitet personenbezogene Daten. Die Grundsätze gelten daher unmittelbar für diesen Verarbeitungsschritt.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_5\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"sicher\"},{\"regelwerk\":\"Verordnung (EU) 2016/679\",\"fundstelle\":\"Art. 6 Abs. 1\",\"typ\":\"zuordnung\",\"fehlender_schritt\":null,\"hinweis\":\"Vor der Verarbeitung muss die Hochschule die konkret einschlägige Rechtsgrundlage festlegen; welche Rechtsgrundlage trägt, lässt sich aus den Angaben zum Task allein nicht abschließend bestimmen.\",\"begruendung\":\"Die Verarbeitung der Bewerbungsunterlagen und ihre Auswertung durch das KI-Tool sind nur rechtmäßig, wenn mindestens eine der in Art. 6 Abs. 1 genannten Bedingungen erfüllt ist.\",\"quelle_url\":\"https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_6\",\"fassung_datum\":\"konsolidierte Fassung vom 04.05.2016\",\"sicherheit\":\"unsicher\"}]}",
          "type": "output_text",
          "logprobs": [],
          "parsed": {
            "funde": [
              {
                "regelwerk": "Verordnung (EU) 2016/679",
                "fundstelle": "Art. 5 Abs. 1",
                "typ": "zuordnung",
                "fehlender_schritt": null,
                "hinweis": "Bei der KI-Auswertung sind insbesondere Zweckbindung, Datenminimierung, Richtigkeit, Speicherbegrenzung sowie Integrität und Vertraulichkeit einzuhalten; die Hochschule muss die Einhaltung nachweisen können.",
                "begruendung": "Die Auswertung von Bewerbungsunterlagen mit einem KI-Tool verarbeitet personenbezogene Daten. Die Grundsätze gelten daher unmittelbar für diesen Verarbeitungsschritt.",
                "quelle_url": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02016R0679-20160504#art_5",
                "fassung_datum": "konsolidierte Fassung vom 04.05.2016",
                "sicherheit": "sicher"
              },
              {
                "regelwerk": "Verordnung (EU) 2016/679",
                "fundstelle": "Art. 6 Abs. 1",
